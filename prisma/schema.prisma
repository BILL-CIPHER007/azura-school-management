generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROFESSOR
  ALUNO
  RESPONSAVEL
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SchoolPlan {
  ESSENCIAL
  PROFISSIONAL
}

enum ChargeStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum PaymentProvider {
  ASAAS
}

enum ExternalBillingType {
  PIX
  BOLETO
}

enum FinancialEventSource {
  ADMIN
  WEBHOOK
  RECONCILIATION
  SYSTEM
}

enum BillingTargetScope {
  SCHOOL
  CLASSROOM
}

enum BillingAutomationRunStatus {
  SUCCESS
  SKIPPED
  FAILED
}

enum BillingAutomationTrigger {
  CRON
  MANUAL
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  COMPLETED
  CANCELLED
}

enum Shift {
  MATUTINO
  VESPERTINO
  NOTURNO
  INTEGRAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

enum AnnouncementAudience {
  SCHOOL
  PROFESSORS
  STUDENTS
  GUARDIANS
  CLASSROOM
}

enum CalendarEventType {
  PROVA
  REUNIAO
  EVENTO
  FERIADO
  ATIVIDADE
  PRAZO
}

model School {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  plan                      SchoolPlan                 @default(ESSENCIAL)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  students                  Student[]
  guardians                 Guardian[]
  teachers                  Teacher[]
  enrollments               Enrollment[]
  classrooms                Classroom[]
  subjects                  Subject[]
  periods                   AcademicPeriod[]
  academicYears             AcademicYear[]
  grades                    Grade[]
  attendances               Attendance[]
  announcements             Announcement[]
  events                    CalendarEvent[]
  diaryEntries              ClassDiaryEntry[]
  charges                   Charge[]
  billingRules              BillingRule[]
  billingBatches            BillingBatch[]
  billingAutomationRuns     BillingAutomationRun[]
  auditLogs                 AuditLog[]
  financialEvents           ChargeFinancialEvent[]
  guardianExternalCustomers GuardianExternalCustomer[]
}

model User {
  id                    String                 @id @default(cuid())
  schoolId              String
  name                  String
  email                 String
  passwordHash          String
  role                  UserRole
  status                UserStatus             @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student               Student?
  guardian              Guardian?
  teacher               Teacher?
  auditLogs             AuditLog[]
  financialEvents       ChargeFinancialEvent[]
  billingBatches        BillingBatch[]
  billingAutomationRuns BillingAutomationRun[]

  @@unique([schoolId, email])
  @@index([schoolId, role])
}

model AcademicYear {
  id          String           @id @default(cuid())
  schoolId    String
  year        Int
  startsAt    DateTime
  endsAt      DateTime
  closedAt    DateTime?
  isActive    Boolean          @default(false)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periods     AcademicPeriod[]
  classrooms  Classroom[]
  enrollments Enrollment[]
  events      CalendarEvent[]

  @@unique([schoolId, year])
}

model AcademicPeriod {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  closedAt       DateTime?
  sortOrder      Int
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grades         Grade[]

  @@unique([schoolId, academicYearId, sortOrder])
}

model Student {
  id          String            @id @default(cuid())
  schoolId    String
  userId      String?           @unique
  fullName    String
  cpf         String?
  birthDate   DateTime?
  gender      String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians   GuardianStudent[]
  enrollments Enrollment[]
  charges     Charge[]

  @@index([schoolId, fullName])
}

model Guardian {
  id                String                     @id @default(cuid())
  schoolId          String
  userId            String?                    @unique
  fullName          String
  cpf               String?
  relation          String
  phone             String?
  email             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  students          GuardianStudent[]
  charges           Charge[]
  externalCustomers GuardianExternalCustomer[]

  @@index([schoolId, fullName])
}

model GuardianExternalCustomer {
  id                 String          @id @default(cuid())
  schoolId           String
  guardianId         String
  provider           PaymentProvider
  externalCustomerId String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian           Guardian        @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([schoolId, guardianId, provider])
  @@unique([provider, externalCustomerId])
  @@index([schoolId, provider])
}

model GuardianStudent {
  guardianId String
  studentId  String
  isPrimary  Boolean  @default(false)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([guardianId, studentId])
}

model Teacher {
  id           String            @id @default(cuid())
  schoolId     String
  userId       String?           @unique
  fullName     String
  email        String?
  phone        String?
  status       UserStatus        @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments  TeacherSubject[]
  grades       Grade[]
  diaryEntries ClassDiaryEntry[]

  @@index([schoolId, fullName])
}

model Subject {
  id           String            @id @default(cuid())
  schoolId     String
  name         String
  code         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments  TeacherSubject[]
  grades       Grade[]
  attendances  Attendance[]
  diaryEntries ClassDiaryEntry[]

  @@unique([schoolId, code])
}

model Classroom {
  id             String            @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  gradeLevel     String
  shift          Shift
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  assignments    TeacherSubject[]
  announcements  Announcement[]
  attendances    Attendance[]
  diaryEntries   ClassDiaryEntry[]
  billingRules   BillingRule[]

  @@unique([schoolId, academicYearId, name])
}

model Enrollment {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  classroomId    String
  academicYearId String
  registration   String
  enrolledAt     DateTime
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom      Classroom        @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  grades         Grade[]
  attendances    Attendance[]
  charges        Charge[]

  @@unique([schoolId, registration])
  @@index([schoolId, status])
}

model Charge {
  id                String                 @id @default(cuid())
  schoolId          String
  studentId         String
  guardianId        String?
  enrollmentId      String?
  reference         String
  description       String?
  amount            Decimal                @db.Decimal(10, 2)
  dueDate           DateTime
  status            ChargeStatus           @default(PENDING)
  paidAt            DateTime?
  canceledAt        DateTime?
  provider          PaymentProvider?
  externalPaymentId String?                @unique
  billingType       ExternalBillingType?
  invoiceUrl        String?
  externalStatus    String?
  syncError         String?
  lastSyncedAt      DateTime?
  refundRequestedAt DateTime?
  refundedAt        DateTime?
  billingRuleId     String?
  billingBatchId    String?
  competence        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  school            School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian          Guardian?              @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  enrollment        Enrollment?            @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  billingRule       BillingRule?           @relation(fields: [billingRuleId], references: [id], onDelete: SetNull)
  billingBatch      BillingBatch?          @relation(fields: [billingBatchId], references: [id], onDelete: SetNull)
  financialEvents   ChargeFinancialEvent[]

  @@unique([schoolId, studentId, billingRuleId, competence])
  @@index([schoolId, status, dueDate])
  @@index([schoolId, studentId])
  @@index([schoolId, guardianId])
  @@index([schoolId, dueDate])
  @@index([schoolId, provider, externalStatus])
  @@index([schoolId, billingRuleId, competence])
  @@index([schoolId, billingBatchId])
}

model ChargeFinancialEvent {
  id                     String               @id @default(cuid())
  schoolId               String
  chargeId               String
  userId                 String?
  source                 FinancialEventSource
  action                 String
  previousStatus         ChargeStatus?
  nextStatus             ChargeStatus?
  previousExternalStatus String?
  nextExternalStatus     String?
  message                String?
  externalEventId        String?
  createdAt              DateTime             @default(now())
  school                 School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  charge                 Charge               @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  user                   User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, chargeId, createdAt])
  @@index([chargeId, createdAt])
  @@index([externalEventId])
}

model BillingRule {
  id                      String                 @id @default(cuid())
  schoolId                String
  classroomId             String?
  name                    String
  amount                  Decimal                @db.Decimal(10, 2)
  dueDay                  Int
  targetScope             BillingTargetScope     @default(SCHOOL)
  isActive                Boolean                @default(true)
  autoGenerate            Boolean                @default(false)
  generationDay           Int                    @default(1)
  lastGeneratedCompetence String?
  nextGenerationAt        DateTime?
  startsOn                DateTime?
  endsOn                  DateTime?
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  school                  School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom               Classroom?             @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  charges                 Charge[]
  batches                 BillingBatch[]
  automationRuns          BillingAutomationRun[]

  @@index([schoolId, isActive])
  @@index([schoolId, autoGenerate, generationDay])
  @@index([schoolId, classroomId])
}

model BillingBatch {
  id               String      @id @default(cuid())
  schoolId         String
  billingRuleId    String
  competence       String
  dueDate          DateTime
  totalStudents    Int         @default(0)
  eligibleStudents Int         @default(0)
  skippedStudents  Int         @default(0)
  existingCharges  Int         @default(0)
  generatedCharges Int         @default(0)
  amountTotal      Decimal     @default(0) @db.Decimal(10, 2)
  generatedById    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  billingRule      BillingRule @relation(fields: [billingRuleId], references: [id], onDelete: Restrict)
  generatedBy      User?       @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  charges          Charge[]

  @@unique([schoolId, billingRuleId, competence])
  @@index([schoolId, competence])
  @@index([schoolId, createdAt])
}

model BillingAutomationRun {
  id               String                     @id @default(cuid())
  schoolId         String
  billingRuleId    String?
  competence       String
  trigger          BillingAutomationTrigger   @default(CRON)
  status           BillingAutomationRunStatus
  eligibleStudents Int                        @default(0)
  generatedCharges Int                        @default(0)
  existingCharges  Int                        @default(0)
  skippedStudents  Int                        @default(0)
  errorMessage     String?
  triggeredById    String?
  createdAt        DateTime                   @default(now())
  school           School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  billingRule      BillingRule?               @relation(fields: [billingRuleId], references: [id], onDelete: SetNull)
  triggeredBy      User?                      @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, billingRuleId, createdAt])
}

model TeacherSubject {
  id          String    @id @default(cuid())
  schoolId    String
  teacherId   String
  subjectId   String
  classroomId String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classroomId])
  @@index([schoolId])
}

model Grade {
  id               String         @id @default(cuid())
  schoolId         String
  enrollmentId     String
  subjectId        String
  academicPeriodId String
  teacherId        String
  av1              Float          @default(0)
  av2              Float          @default(0)
  assignment       Float          @default(0)
  average          Float          @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment       Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  teacher          Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([schoolId, enrollmentId, subjectId, academicPeriodId])
}

model Attendance {
  id           String           @id @default(cuid())
  schoolId     String
  enrollmentId String
  classroomId  String
  subjectId    String
  date         DateTime
  status       AttendanceStatus
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classroom    Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject      Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, enrollmentId, subjectId, date])
}

model ClassDiaryEntry {
  id          String    @id @default(cuid())
  schoolId    String
  classroomId String
  subjectId   String
  teacherId   String
  date        DateTime
  content     String
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([schoolId, classroomId, subjectId, teacherId, date])
  @@index([schoolId, classroomId, subjectId, date])
  @@index([schoolId, teacherId, date])
}

model Announcement {
  id          String               @id @default(cuid())
  schoolId    String
  classroomId String?
  authorId    String
  title       String
  content     String
  audience    AnnouncementAudience
  publishedAt DateTime             @default(now())
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom   Classroom?           @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@index([schoolId, audience])
}

model CalendarEvent {
  id             String            @id @default(cuid())
  schoolId       String
  academicYearId String
  title          String
  description    String?
  type           CalendarEventType
  startsAt       DateTime
  startTime      String?
  endTime        String?
  endsAt         DateTime?
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([schoolId, startsAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

model AsaasWebhookEvent {
  id                String    @id @default(cuid())
  externalEventId   String    @unique
  eventType         String
  externalPaymentId String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  processingError   String?

  @@index([externalPaymentId])
  @@index([receivedAt])
}
